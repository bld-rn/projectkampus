# Salin berkas ini menjadi ".env" lalu ubah nilainya bila perlu.
# Semua baris bersifat opsional; nilai di bawah adalah bawaannya.

# Nama aplikasi dan kampus yang tampil di bagian atas halaman
APP_NAMA=Projek Kuliah
KAMPUS_NAMA=Universitas Widyatama

# Kode yang harus diisi teman sekelas saat mendaftar.
# Kosongkan agar dibuat otomatis (akan tampil di terminal saat pertama kali dijalankan).
KODE_KELAS=

# Lokasi berkas database (di hosting, arahkan ke folder penyimpanan permanen)
DB_PATH=data/projectkampus.db

PORT=3000
